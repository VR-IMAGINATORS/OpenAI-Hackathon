{
  "name": "call-to-the-past-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx tools/dev.ts",
    "dev:all": "node --import tsx tools/dev.ts --mock",
    "dev:web": "vite",
    "check": "tsc --noEmit && tsx tools/validate-scenario.ts",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/server/index.js",
    "validate:scenario": "tsx tools/validate-scenario.ts",
    "play:mobile": "npm run build && node --import tsx tools/mobile.ts",
    "play:mobile:start": "node --import tsx tools/mobile.ts",
    "format": "prettier --write \"{apps,packages,tools,tests}/**/*.{ts,tsx,js,cjs,mjs,css}\" \"scenarios/**/*.json\" package.json .prettierrc.json",
    "format:check": "prettier --check \"{apps,packages,tools,tests}/**/*.{ts,tsx,js,cjs,mjs,css}\" \"scenarios/**/*.json\" package.json .prettierrc.json",
    "probe:live": "node --import tsx tools/core-live-probe.ts --live",
    "probe:preview": "node --import tsx tools/core-live-probe.ts",
    "mission": "node --import tsx tools/auto-mission.ts",
    "play:expanded": "npm run build && node --import tsx tools/play-expanded.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
