{
  "openapi": "3.1.0",
  "info": {
    "title": "Ending video API",
    "version": "0.1.0",
    "description": "Hosted ending results. Read-only endpoints never start generation."
  },
  "security": [
    {
      "playSession": []
    }
  ],
  "paths": {
    "/api/play/ending": {
      "get": {
        "operationId": "getEnding",
        "summary": "Return the authenticated owner’s ending status.",
        "parameters": [
          {
            "$ref": "#/components/parameters/playId"
          }
        ],
        "responses": {
          "200": {
            "description": "Status after an ending or interruption is recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndingView"
                }
              }
            }
          },
          "401": {
            "description": "Session is not authorized to read results."
          },
          "404": {
            "description": "The retained result belongs to another owner."
          },
          "409": {
            "description": "The game has not recorded an ending yet (ENDING_NOT_STARTED)."
          },
          "410": {
            "description": "No retained result exists, or the session has expired."
          }
        }
      }
    },
    "/api/play/ending/video": {
      "get": {
        "operationId": "getEndingVideo",
        "summary": "Read the owner’s retained MP4, including a single byte range.",
        "parameters": [
          {
            "$ref": "#/components/parameters/playId"
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete retained MP4.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string",
                  "const": "bytes"
                }
              }
            },
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Requested byte range.",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string",
                  "const": "bytes"
                }
              }
            },
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Session is not authorized to read results."
          },
          "404": {
            "description": "The retained result belongs to another owner."
          },
          "409": {
            "description": "Video is not ready."
          },
          "410": {
            "description": "No retained result exists, or the session has expired."
          },
          "416": {
            "description": "Invalid, multiple, or unsatisfiable range."
          }
        }
      },
      "head": {
        "operationId": "headEndingVideo",
        "summary": "Return the same ownership checks and video metadata, without body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/playId"
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata for a ready MP4. No response body."
          },
          "401": {
            "description": "Unauthorized."
          },
          "404": {
            "description": "The retained result belongs to another owner."
          },
          "409": {
            "description": "Video is not ready."
          },
          "410": {
            "description": "No retained result exists, or the session has expired."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "playSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "play_session"
      }
    },
    "parameters": {
      "playId": {
        "name": "playId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "EndingView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playId",
          "outcome",
          "clearedCount",
          "status",
          "errorCode",
          "retainUntil",
          "videoPath",
          "story",
          "storyStatus"
        ],
        "properties": {
          "playId": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": ["string", "null"],
            "enum": ["happy", "normal", "bad", null]
          },
          "clearedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "status": {
            "type": "string",
            "enum": [
              "disabled",
              "not_applicable",
              "queued",
              "preparing",
              "generating",
              "ready",
              "failed",
              "expired"
            ]
          },
          "errorCode": {
            "type": ["string", "null"],
            "maxLength": 64
          },
          "retainUntil": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "videoPath": {
            "type": ["string", "null"],
            "description": "Same-origin /api/play/ending/video?playId=... only when ready."
          },
          "storyStatus": {
            "type": "string",
            "enum": ["queued", "generating", "ready", "failed", "disabled", "not_applicable"],
            "description": "Text readiness, independent from video. Keep polling while queued/generating even when video is disabled or failed."
          },
          "story": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EndingStory"
              }
            ]
          }
        }
      },
      "EndingStory": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "text", "evaluation"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "description": "New tagged endings contain at most 240 characters; legacy stories may be longer."
          },
          "tagId": {
            "type": ["string", "null"],
            "enum": [
              "tableware_only",
              "outdoor_items",
              "fantasy",
              "firearms_only",
              "verbal_override",
              "stationery",
              "tools",
              "cleaning",
              "appliances",
              "wardrobe",
              "food",
              "plush",
              "money",
              "oversized",
              "science_fiction",
              "combination",
              "one_tool",
              "brute_force",
              "unexpected_use",
              "persistent_retry",
              "sports",
              "music",
              "gardening",
              "bathroom",
              "packaging",
              "rubber_band",
              "adhesive",
              "magnet",
              "light",
              "water",
              "heat",
              "leverage",
              "reach",
              "precision",
              "cushion",
              "disassembly",
              "recycle",
              "learning",
              "bare_hands",
              "variety",
              null
            ]
          },
          "tagCatalogVersion": {
            "type": "integer",
            "const": 1
          },
          "evaluation": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
