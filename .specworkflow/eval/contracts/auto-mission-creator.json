{
  "schema_version": 1,
  "id": "auto-mission-creator",
  "title": "自動ミッション生成プロトタイプ",
  "goal": "新規ギミックを自動生成し、人間介在なしに実現可能性を検証する独立CLI",
  "source": {
    "type": "spec-workflow",
    "spec_path": "specs/auto-mission-creator/spec.md"
