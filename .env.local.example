# Copy to .env.local. Server only; never commit actual credentials.
APP_PASSPHRASE=replace-with-your-shared-passphrase
AI_MODE=live
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
RESPONSE_MODEL=gpt-5.6-terra
GAME_MODEL=gpt-5.6-sol
AI_GLOBAL_LIVE_ATTEMPTS=100
AI_GLOBAL_RESPONSE_ATTEMPTS=1000
MAX_PLAYERS=5
HOST=127.0.0.1
PORT=4310
SCENARIO_PATH=scenarios/playtest/warehouse-expanded-r1.json
# Optional fixed HTTPS tunnel origin. Otherwise play:mobile starts cloudflared.
# PUBLIC_APP_URL=https://your-game.example.com
# CLOUDFLARED_PATH=C:/tools/cloudflared.exe
# OPS_TOKEN=at-least-32-random-characters-here

# Scene generation and inspection (independent from voice/Responses budget)
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_INSPECTION_MODEL=gpt-5.6-luna
AI_GLOBAL_IMAGE_ATTEMPTS=100
AI_GLOBAL_INSPECTION_ATTEMPTS=100
IMAGE_REQUESTS_PER_MINUTE=5
IMAGE_CONCURRENT=2
IMAGE_INSPECTION_CONCURRENT=2
IMAGE_JOB_TIMEOUT_SECONDS=150
RESULT_TTL_SECONDS=300
AI_RESPONSES_PER_PLAY=80
ENABLE_GAME_TRACE=0

# Optional ending video (server only). See docs/fal-ending-setup.md.
ENDING_VIDEO_ENABLED=false
FAL_KEY=
# Required when enabled; 1..1000 attempts per server process, reset at restart.
# AI_GLOBAL_VIDEO_ATTEMPTS=1
ENDING_JOB_TIMEOUT_SECONDS=480
ENDING_CONCURRENT=2
# When enabled, change RESULT_TTL_SECONDS above to 600 (timeout + 60 or more).
