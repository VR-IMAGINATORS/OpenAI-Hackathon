# Local app only. Copy to .env.local. Never put provider API keys here.
RELAY_URL=http://127.0.0.1:4311
SCENARIO_PATH=scenarios/default.json
LOCAL_HOST=127.0.0.1
LOCAL_PORT=4310
# Optional exact comma-separated allowlists (defaults cover Vite and local serving).
# LOCAL_ALLOWED_HOSTS=127.0.0.1:4310,localhost:4310,127.0.0.1:5173,localhost:5173
# LOCAL_ALLOWED_ORIGINS=http://127.0.0.1:4310,http://localhost:4310,http://127.0.0.1:5173,http://localhost:5173
LOCAL_RELAY_TIMEOUT_MS=10000
