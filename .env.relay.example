# Operator only. Copy to .env.relay.local. Never commit the real file.
RELAY_AUTH_MODE=required
RELAY_PASSPHRASE=
RELAY_HOST=127.0.0.1
RELAY_PORT=4311
# required fails to start until RELAY_PASSPHRASE is set.
# RELAY_AUTH_MODE=none disables only passphrase checking; quotas stay enabled.
# Default is mock. Enable live using the operator-only settings below.

# In-memory limits. Reset on restart; not production billing caps.
RELAY_TOKEN_TTL_SECONDS=900
RELAY_TOKEN_MAX_REQUESTS=4
RELAY_MAX_SESSIONS=100
RELAY_MAX_REQUESTS=1000
RELAY_AUTH_MAX_ATTEMPTS=30
RELAY_AUTH_WINDOW_SECONDS=60

# Enable only on the operator machine. Keep this key out of judges' setup.
# RELAY_MODE=live
# OPENAI_API_KEY=replace-on-operator-machine
# RELAY_LIVE_MODELS=gpt-live-1
# RELAY_RESPONSE_MODELS=gpt-5.6-terra
# Required global limits in live mode (example test allowance):
# RELAY_GLOBAL_LIVE_ATTEMPTS=10
# RELAY_GLOBAL_RESPONSE_ATTEMPTS=100
# RELAY_GLOBAL_LIVE_CONCURRENT=1
# RELAY_GLOBAL_RESPONSE_CONCURRENT=1
# RELAY_AUTH_GLOBAL_MAX_ATTEMPTS=100
# Optional per-token limits:
# RELAY_TOKEN_LIVE_ATTEMPTS=3
# RELAY_TOKEN_RESPONSE_ATTEMPTS=40
# RELAY_LIVE_DURATION_SECONDS=600
# RELAY_MAX_OUTPUT_TOKENS=1000
# Token TTL is set above; keep only one definition.
