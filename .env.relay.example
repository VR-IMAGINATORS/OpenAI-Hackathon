# Operator only. Copy to .env.relay.local. Never commit the real file.
RELAY_AUTH_MODE=required
RELAY_PASSPHRASE=
RELAY_HOST=127.0.0.1
RELAY_PORT=4311
# required fails to start until RELAY_PASSPHRASE is set.
# RELAY_AUTH_MODE=none disables only passphrase checking; quotas stay enabled.
# Current relay supports MOCK diagnostics only. Do not add real API keys yet.

# In-memory limits. Reset on restart; not production billing caps.
RELAY_TOKEN_TTL_SECONDS=300
RELAY_TOKEN_MAX_REQUESTS=4
RELAY_MAX_SESSIONS=100
RELAY_MAX_REQUESTS=1000
RELAY_AUTH_MAX_ATTEMPTS=30
RELAY_AUTH_WINDOW_SECONDS=60
